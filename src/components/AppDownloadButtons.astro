---
import { APP_STORE_URL, WEB_APP_URL } from '../config/site';

export interface Props {
  /** "light" for use on purple/dark backgrounds, "dark" for use on white */
  tone?: 'light' | 'dark';
  align?: 'center' | 'left';
  showAndroid?: boolean;
}

const { tone = 'dark', align = 'center', showAndroid = true } = Astro.props;
const webClasses =
  tone === 'light'
    ? 'border-2 border-white text-white hover:bg-white hover:text-primary-700'
    : 'border-2 border-primary-600 text-primary-700 hover:bg-primary-50';
// Official Apple badge artwork (US-UK English): white on purple backgrounds, black on light backgrounds
const badgeSrc =
  tone === 'light'
    ? '/images/Download_on_the_App_Store_Badge_US-UK_RGB_wht_092917.svg'
    : '/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
const noteClasses = tone === 'light' ? 'text-primary-100' : 'text-gray-500';
---

<div class:list={['flex flex-col gap-3', align === 'center' ? 'items-center' : 'items-start']}>
  <div class:list={['flex flex-col sm:flex-row gap-3', align === 'center' ? 'justify-center' : 'justify-start']}>
    <a
      href={APP_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center hover:opacity-90 transition-opacity"
    >
      <img
        src={badgeSrc}
        alt="Download on the App Store"
        width="144"
        height="48"
        class="h-12 w-auto"
      />
    </a>
    <a
      href={WEB_APP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class:list={['inline-flex items-center justify-center gap-2 h-12 px-5 rounded-lg font-semibold transition-colors', webClasses]}
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Open the web app
    </a>
  </div>
  {showAndroid && (
    <p class:list={['text-sm', noteClasses]}>
      iPhone and web available now. Android coming soon.
    </p>
  )}
</div>
