---
import BaseLayout from './BaseLayout.astro';
import AuthorBioCard from '../components/AuthorBioCard.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  tags?: string[];
  author?: {
    name: string;
    role: string;
    avatar: string;
    bio: string;
    socials?: {
      instagram?: string;
      strava?: string;
    };
  };
}

const { title, description, pubDate, image, tags, author } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={image}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-8">
      {image && (
        <img
          src={image}
          alt={title}
          class="w-full h-64 md:h-96 object-cover rounded-lg mb-6"
        />
      )}
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{title}</h1>
      {author && (
        <div class="flex items-center gap-3 mb-4">
          <img
            src={author.avatar}
            alt={`${author.name} profile image`}
            class="w-12 h-12 rounded-full object-cover"
            loading="lazy"
          />
          <div>
            <p class="text-sm font-semibold text-gray-900">{author.name}</p>
            <p class="text-sm text-gray-600">{author.role}</p>
          </div>
        </div>
      )}
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
        <time datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-2 py-1 bg-primary-100 text-primary-700 rounded-full text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>
    <div class="post-content prose prose-lg prose-primary max-w-none">
      <slot />
    </div>
    {author && <AuthorBioCard author={author} />}
  </article>
</BaseLayout>

<style is:global>
  .post-content img {
    max-height: 70vh;
    width: auto;
    margin-inline: auto;
    display: block;
  }
</style>
