---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  category?: string;
  tags?: string[];
  related?: string[];
}

const props = Astro.props.frontmatter ?? Astro.props;
const { title, description, category, tags, related } = props;

function slugToTitle(slug: string): string {
  return slug
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

<BaseLayout title={`${title} — Support`} description={description}>
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <nav class="text-sm text-gray-500 mb-8">
        <a href="/support-center" class="hover:text-primary-600">Support Center</a>
        {category && (
          <>
            <span class="mx-2">›</span>
            <span class="text-gray-700">{category}</span>
          </>
        )}
      </nav>

      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{title}</h1>
        <p class="text-xl text-gray-600 mb-4">{description}</p>
        {related && related.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-4 text-sm">
            <span class="text-gray-500">Related:</span>
            {related.map((slug, i) => (
              <>
                <a href={`/support-center/${slug}`} class="text-primary-600 hover:underline">{slugToTitle(slug)}</a>
                {i < related.length - 1 && <span class="text-gray-300">·</span>}
              </>
            ))}
          </div>
        )}
      </header>

      <div class="article-body prose prose-lg prose-primary max-w-none mb-12">
        <slot />
      </div>

      {related && related.length > 0 && (
        <div class="bg-white rounded-lg shadow-md p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Related articles</h2>
          <ul class="space-y-3">
            {related.map(slug => (
              <li class="flex items-start">
                <span class="text-primary-600 mr-2 mt-1">•</span>
                <a href={`/support-center/${slug}`} class="text-primary-600 hover:text-primary-700 hover:underline">{slugToTitle(slug)}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="bg-gray-50 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Need More Help?</h2>
        <p class="text-gray-600 mb-6">Can't find what you're looking for? Get in touch with our team.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/support-center"
            class="inline-block bg-white border border-primary-600 text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors"
          >
            Back to Support Center
          </a>
          <a
            href="/support-center/contact"
            class="inline-block bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
          >
            Contact Us
          </a>
        </div>
      </div>

    </div>
  </section>

<style is:global>
  .article-body figure {
    margin: 1.5rem auto;
    max-width: 390px;
  }

  .article-body figure img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
  }

  .article-body figcaption {
    font-size: 0.8rem;
    color: #666;
    text-align: center;
    margin-top: 0.5rem;
  }
</style>
</BaseLayout>
