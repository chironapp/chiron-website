---
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import AppDownloadButtons from '../components/AppDownloadButtons.astro';
import LandingLayout from '../layouts/LandingLayout.astro';

const base = import.meta.env.BASE_URL;
const blogPosts = await getCollection('blog');
const recentPosts = blogPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Process posts to handle co-located images
const processedRecentPosts = recentPosts.map(post => {
  let imageUrl = post.data.image;
  if (typeof post.data.image === 'object' && post.data.image?.src) {
    imageUrl = post.data.image.src;
  }
  return {
    ...post,
    processedImage: imageUrl
  };
});
---

<LandingLayout
  title="Chiron - Training planning and coaching for runners"
  description="Chiron is the training platform for competitive runners and their coaches. Plan your season, sync every session from Strava, and keep coach and athlete on the same page. Available on iPhone and the web."
>
  <!-- Hero Section -->
  <section slot="hero" class="bg-gradient-to-r from-primary-600 to-primary-800 text-white py-20 md:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">
        Plan. Adapt. Perform.
      </h1>
      <p class="text-xl md:text-2xl text-primary-100 mb-10 max-w-3xl mx-auto lg:mx-0">
        Training platform for coaches, competitive runners and clubs. Plan your season, sync every session, optimize training and perform on race day.
      </p>
      <div class="hidden lg:block"><AppDownloadButtons tone="light" align="left" /></div>
      <div class="lg:hidden"><AppDownloadButtons tone="light" /></div>
      </div>
      <img
        src="/images/screenshots/chiron-ios-training-summary-duration-framed.webp"
        alt="Chiron on iPhone showing an athlete's weekly planned, completed and missed running time over a training block"
        width="640"
        height="1315"
        class="w-60 md:w-72 lg:w-80 h-auto mx-auto drop-shadow-2xl"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- All Feature Sections -->
  <div slot="features">
    <!-- Athletes -->
    <section id="athletes" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 mb-2">For athletes</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Your whole season in one schedule</h2>
          <p class="text-lg text-gray-600 mb-6">
            Planned workouts, completed runs, strength & conditioning, racing and notes, all in one place. Swap the spreadsheet for a schedule that knows what athelets have actually done.
          </p>
          <ul class="space-y-4 text-gray-700 mb-6">
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Plan your week.</strong> Schedule runs, cross training and strength work, and repeat key workouts across a block in one step.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Plan your races.</strong> Add goal races with race goals, a race-week checklist and attachments so athletes reach the start line ready.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Sync from Strava.</strong> Completed workouts land automatically and match up against what you planned.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Track what counts.</strong> Personal bests built from your official race results, with GPS efforts in between.</span></li>
          </ul>
          <a href={`${base}support-center/#athletes`} class="text-primary-600 font-medium hover:text-primary-700">Athlete guides →</a>
        </div>
        <div class="flex justify-center items-start gap-4 sm:gap-6">
          <img
            src="/images/screenshots/chiron-ios-race-event.webp"
            alt="A race event in Chiron with the official result, goals achieved and attachments"
            width="600" height="1301" loading="lazy"
            class="w-40 sm:w-52 lg:w-56 h-auto rounded-3xl shadow-xl ring-1 ring-gray-200"
          />
          <img
            src="/images/screenshots/chiron-ios-personal-bests.webp"
            alt="Chiron Personal Bests chart showing 5km official results and GPS efforts over time"
            width="600" height="1301" loading="lazy"
            class="w-40 sm:w-52 lg:w-56 h-auto rounded-3xl shadow-xl ring-1 ring-gray-200"
          />
        </div>
      </div>
    </section>

    <!-- Coaches -->
    <section id="coaches" class="py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 mb-2">For coaches</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Coach your team from one place</h2>
            <p class="text-lg text-gray-600 mb-6">
              Plan, adjust and review every athlete's training without chasing screenshots and spreadsheets. Works on iPhone and on the desktop web app.
            </p>
            <a href={`${base}support-center/#coaches`} class="text-primary-600 font-medium hover:text-primary-700">Coach guides →</a>
          </div>
          <ul class="space-y-4 text-gray-700">
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Invite your athletes.</strong> Send invitations by email. Athletes accept in the app and you can see and manage their training.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>See your roster at a glance.</strong> Latest workout, next race, planned sessions and compliance for every athlete you coach.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Plan into their schedule.</strong> Switch to an athlete's schedule and plan sessions easily from your workout library.</span></li>
              <li class="flex items-start"><svg class="w-5 h-5 text-primary-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span><strong>Keep the conversation on the session.</strong> Comment on workouts and notes, and keep private coaching notes per athlete.</span></li>
          </ul>
        </div>

        <div class="mt-12 relative pb-10 pl-6 sm:pb-12 sm:pl-10">
          <img
            src="/images/screenshots/chiron-web-coach-schedule.webp"
            alt="Chiron desktop web app showing a coach viewing an athlete's schedule with the workout library beside the calendar"
            width="1471" height="892" loading="lazy"
            class="w-full h-auto rounded-xl shadow-2xl ring-1 ring-gray-200"
          />
          <img
            src="/images/screenshots/chiron-ios-athlete-schedule-framed.webp"
            alt="An athlete's schedule in the Chiron iPhone app, showing completed runs and rides with time, distance and pace"
            width="640" height="1315" loading="lazy"
            class="absolute bottom-0 left-0 w-28 sm:w-40 lg:w-52 h-auto drop-shadow-2xl"
          />
        </div>

        <div class="mt-12 rounded-2xl border-2 border-primary-200 bg-white p-8 md:flex md:items-center md:justify-between gap-8">
          <div class="max-w-2xl">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Running coach in Australia? Try Coach Preview free.</h3>
            <p class="text-gray-600">
              Coach features are in a limited preview while we work closely with a small group of coaches. If you coach runners in Australia and want to try Chiron with your athletes, get in touch for a free Coach Preview access code. In return, we're after honest feedback on what works and what doesn't.
            </p>
          </div>
          <a
            href={`${base}contact/#coaches`}
            class="mt-6 md:mt-0 inline-block flex-shrink-0 px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors"
          >
            Request a code
          </a>
        </div>
      </div>
    </section>

    <!-- Clubs -->
    <section id="clubs" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 mb-2">For clubs</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Club racing, simplified
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Running a club race? Chiron handles start lists, race-day timing on your own phone or laptop, and instant published results your participants can find straight after the race.
          </p>
          <a href={`${base}race-organisers/`} class="text-primary-600 font-medium hover:text-primary-700">
            Learn more →
          </a>
        </div>
        <div class="relative pb-10 pr-6 sm:pr-10">
          <img
            src="/images/screenshots/chiron-web-race-results.webp"
            alt="Published Bush Turkey Relay results on the web, with individual and team results searchable by name or race number"
            width="1278" height="1007" loading="lazy"
            class="w-full h-auto rounded-xl shadow-xl ring-1 ring-gray-200"
          />
          <img
            src="/images/screenshots/chiron-ios-race-timing.webp"
            alt="Race timing in the Chiron app, with the race clock and a timer button for each runner"
            width="600" height="1301" loading="lazy"
            class="absolute bottom-0 right-0 w-28 sm:w-36 lg:w-40 h-auto rounded-2xl shadow-2xl ring-1 ring-gray-200"
          />
        </div>
      </div>
    </section>

    <!-- Built by runners -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Built by runners, tested in training</h2>
        <p class="text-lg text-gray-600">
          Chiron is built by Brisbane’s Clive Gross, a 2:27 marathoner and coach of the Bush Turkey Track Club, who plans his own training in it every week. He tests every feature with local coaches and athletes he trains alongside.
        </p>
        <a href={`${base}about/`} class="inline-block mt-4 text-primary-600 font-medium hover:text-primary-700">About Chiron →</a>
      </div>
    </section>

    <!-- Recent Blog Posts -->
    {recentPosts.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Latest from the Blog
            </h2>
            <p class="text-lg text-gray-600">
              Stay up to date with our latest training tips and insights.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {processedRecentPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={`blog/${post.slug}`}
                image={post.processedImage}
                tags={post.data.tags}
              />
            ))}
          </div>
          <div class="text-center mt-8">
            <a
              href={`${base}blog/`}
              class="inline-block px-6 py-3 text-primary-600 font-medium hover:text-primary-700"
            >
              View all posts →
            </a>
          </div>
        </div>
      </section>
    )}
  </div>

  <!-- CTA Section -->
  <section slot="cta" class="py-20 bg-primary-600">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Start planning your next block
      </h2>
      <p class="text-lg text-primary-100 mb-8">
        Free to download for athletes. Connect Strava and your training history comes with you.
      </p>
      <AppDownloadButtons tone="light" />
    </div>
  </section>
</LandingLayout>
