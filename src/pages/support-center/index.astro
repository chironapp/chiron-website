---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Support Center"
  description="Find answers to common questions or contact us for help with Chiron."
>
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 text-center">
        Support Center
      </h1>
      <p class="text-xl text-gray-600 mb-12 text-center">
        Find answers below, or contact us if you need more help.
      </p>

      <!-- Help Documentation Section -->
      <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Help Documentation</h2>

        <div class="space-y-6">
          <div class="border-l-4 border-primary-600 pl-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Getting Started</h3>
            <ul class="space-y-2">
              <li>
                <a href="/support-center/beta-guide" class="text-primary-600 hover:text-primary-700 hover:underline">
                  Beta User Guide
                </a>
                <p class="text-sm text-gray-600 mt-1">Essential guide for beta users to get started with Chiron</p>
              </li>
            </ul>
          </div>

          <div class="border-l-4 border-primary-600 pl-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Schedule &amp; Race Results</h3>
            <ul class="space-y-2">
              <li>
                <a href="/support-center/how-to-import-race-results-bulk-paste-spreadsheet" class="text-primary-600 hover:text-primary-700 hover:underline">
                  How to Import Race Results in Bulk
                </a>
                <p class="text-sm text-gray-600 mt-1">Copy and paste your full race history from Google Sheets, Excel, or Numbers into Chiron in minutes</p>
              </li>
            </ul>
          </div>

          <div class="border-l-4 border-primary-600 pl-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Workout Library</h3>
            <ul class="space-y-2">
              <li>
                <a href="/support-center/creating-your-workout-library" class="text-primary-600 hover:text-primary-700 hover:underline">
                  Creating Your Workout Library
                </a>
                <p class="text-sm text-gray-600 mt-1">Build a reusable library of workouts you can schedule to yourself or your athletes at any time</p>
              </li>
              <li>
                <a href="/support-center/scheduling-from-workout-library" class="text-primary-600 hover:text-primary-700 hover:underline">
                  Scheduling Workouts from the Workout Library
                </a>
                <p class="text-sm text-gray-600 mt-1">Schedule a Library workout to your own or an athlete's calendar, and duplicate workouts to build progressive variations</p>
              </li>
            </ul>
          </div>

          <div class="border-l-4 border-primary-600 pl-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Strength &amp; Conditioning</h3>
            <ul class="space-y-2">
              <li>
                <a href="/support-center/strength-and-conditioning" class="text-primary-600 hover:text-primary-700 hover:underline">
                  Strength &amp; Conditioning in Chiron
                </a>
                <p class="text-sm text-gray-600 mt-1">Create strength and physical therapy workouts, build your Exercise Library, and manage sessions alongside your run training</p>
              </li>
              <li>
                <a href="/support-center/recording-a-strength-workout" class="text-primary-600 hover:text-primary-700 hover:underline">
                  Recording a Strength Workout
                </a>
                <p class="text-sm text-gray-600 mt-1">Track your session in real time — check off exercises or log every set with reps and load</p>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Contact Section -->
      <div class="bg-gray-50 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Still need help?</h2>
        <p class="text-gray-600 mb-6">
          Can't find what you're looking for? Get in touch with our team.
        </p>
        <a
          href="/support-center/contact"
          class="inline-block bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
