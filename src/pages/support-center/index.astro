---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supportAudiences, supportHref } from '../../data/support-articles';
import { REPORT_PROBLEM_URL } from '../../config/site';

const base = import.meta.env.BASE_URL;
const audienceCards = supportAudiences.filter((aud) => aud.id !== 'account');
---

<BaseLayout
  title="Support Center"
  description="Guides for athletes, coaches and clubs using Chiron, plus account help and a form to report a problem."
>
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 text-center">
        Support Center
      </h1>
      <p class="text-xl text-gray-600 mb-10 text-center">
        Guides for getting the most out of Chiron. Pick where you'd like to start.
      </p>

      <!-- Audience picker -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        {audienceCards.map((aud) => (
          <a
            href={`#${aud.id}`}
            class="block bg-white rounded-lg shadow-md p-6 border-2 border-transparent hover:border-primary-600 transition-colors"
          >
            <h2 class="text-xl font-bold text-gray-900 mb-2">{aud.label}</h2>
            <p class="text-sm text-gray-600">{aud.intro}</p>
          </a>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-16 text-sm">
        <a href={`${base}support-center/getting-started/`} class="text-center px-4 py-2 rounded-full bg-primary-50 text-primary-700 font-medium hover:bg-primary-100">New to Chiron? Getting started</a>
        <a href={REPORT_PROBLEM_URL} class="text-center px-4 py-2 rounded-full bg-primary-50 text-primary-700 font-medium hover:bg-primary-100">Report a problem</a>
        <a href={`${base}download/`} class="text-center px-4 py-2 rounded-full bg-primary-50 text-primary-700 font-medium hover:bg-primary-100">Get the app</a>
      </div>

      {supportAudiences.map((aud) => (
        <div id={aud.id} class="bg-white rounded-lg shadow-md p-8 mb-8 scroll-mt-24">
          <h2 class="text-2xl font-bold text-gray-900 mb-1">{aud.label}</h2>
          <p class="text-gray-600 mb-6">{aud.intro}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
            {aud.groups.map((group) => (
              <div class="border-l-4 border-primary-600 pl-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-3">{group.title}</h3>
                <ul class="space-y-3">
                  {group.links.map((link) => (
                    <li>
                      <a href={supportHref(link)} class="text-primary-600 hover:text-primary-700 hover:underline font-medium">
                        {link.title}
                      </a>
                      <p class="text-sm text-gray-600 mt-0.5">{link.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Contact Section -->
      <div class="bg-gray-50 rounded-lg p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Still need help?</h2>
        <p class="text-gray-600 mb-6">
          Can't find what you're looking for, or something isn't working? Let us know.
        </p>
        <a
          href={REPORT_PROBLEM_URL}
          class="inline-block bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-700 transition-colors"
        >
          Report a problem
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
